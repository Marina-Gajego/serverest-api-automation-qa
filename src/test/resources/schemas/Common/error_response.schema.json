{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Generic error response schema",
  "type": "object",
  "minProperties": 1,
  "additionalProperties": {
    "oneOf": [
      {
        "type": "string",
        "minLength": 1
      },
      {
        "type": "array"
      },
      {
        "type": "object"
      },
      {
        "type": "number"
      },
      {
        "type": "boolean"
      }
    ]
  }
}
