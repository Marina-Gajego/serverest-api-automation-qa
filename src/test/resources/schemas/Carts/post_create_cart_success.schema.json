{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Create Cart Success Response (201)",
  "type": "object",
  "required": [
    "message",
    "_id"
  ],
  "additionalProperties": false,
  "properties": {
    "message": {
      "type": "string",
      "const": "Cadastro realizado com sucesso"
    },
    "_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9]+$"
    }
  }
}
